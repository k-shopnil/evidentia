# Application
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
APP_NAME=Evidentia
DEBUG=true

# Database
DATABASE_URL=sqlite:///./evidentia.db

# Session
SESSION_COOKIE_NAME=evidentia_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE=3600

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_GENERAL=100/minute

# Account Lockout
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# TOTP
TOTP_ISSUER=Evidentia

# SMTP (for new-device notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Evidentia Security <security@evidentia.local>
SMTP_USE_TLS=true

# File Storage
# STORAGE_BACKEND: local (dev, files on disk) | s3 (Cloudflare R2, deployed)
STORAGE_BACKEND=local
EVIDENCE_STORAGE_PATH=./app/storage/evidence
MAX_FILE_SIZE_MB=100
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/gif,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Cloudflare R2 (only when STORAGE_BACKEND=s3)
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
# R2_BUCKET=evidentia
# R2_PRESIGNED_URL_EXPIRY=300

# Demo Mode (in-browser tamper simulation buttons; leave OFF in production)
# DEMO_MODE=true